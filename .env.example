# Sao chép thành .env.local. Hai giá trị NEXT_PUBLIC dùng được trong browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chỉ server: Supabase secret key hoặc legacy service_role key.
SUPABASE_SECRET_KEY=
SITE_URL=http://127.0.0.1:3000

# Phase 2: chỉ server/worker. Không điền key thật vào file example.
NINE_ROUTER_BASE_URL=https://nine-router-i15k.onrender.com/v1
NINE_ROUTER_API_KEY=
# Model này đã được kiểm tra với gateway ngày 02/11/2026.
# gpt-4o-mini trong yêu cầu ban đầu hiện trả model_not_found; không fallback ngầm.
NINE_ROUTER_MODEL=ag/gemini-3.8-flash
WORKER_HEALTH_PORT=3310
WORKER_HEALTH_HOST=127.0.0.1
# Bật sau khi đơn vị vận hành chốt/công khai chính sách 180 ngày và xóa tài khoản sau 7 ngày.
# Upload tạm không còn gắn hồ sơ vẫn được dọn sau 24 giờ khi false.
DATA_RETENTION_ENABLED=false

# Tùy chọn: chỉ cho npm run test:live trên project TEST riêng.
# Ứng dụng KHÔNG đọc ba biến bên dưới; điền ba biến đầu file để bật tài khoản/CV.
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
SUPABASE_TEST_SECRET_KEY=
