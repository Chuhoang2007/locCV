  "narrative": {
    "northStar": "The Shared Professional Workspace",
    "overview": "LocCV uses a calm, approachable professional workspace to connect one identity with two modes. Forest-green framing, pale green navigation and a warm neutral ground establish continuity across authentication and account settings. This records the implemented direction; it is not a separately approved brand identity.\n\nThe interface gives Vietnamese forms deliberate whitespace and compact supporting text. Its signature is the shared-account diagram: one identity node connects to two equal role branches. Functional controls and honest account states remain the center of the experience.",
    "keyCharacteristics": [
      "Forest-green anchors with pale green supporting surfaces.",
      "Self-hosted Vietnamese typography and restrained weight contrast.",
      "Flat sections, thin separators and softly rounded controls.",
      "One visual identity across candidate and recruiter modes."
    ],
    "rules": [
      {
        "name": "The Shared Identity Rule",
        "body": "Keep the same green palette when the account changes mode; selection communicates context without assigning a new brand to each role.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Use Be Vietnam Pro for headings, forms and navigation; distinguish hierarchy through size, spacing and weight.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Preserve tonal layering and thin separators when extending the current workspace.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep account identity and the green visual language consistent across both modes.",
      "**Do** use self-hosted Be Vietnam Pro with the Vietnamese subset.",
      "**Do** pair error and success colors with clear text and preserve visible keyboard focus.",
      "**Do** use responsive stacked settings sections and the mobile horizontal navigation pattern."
    ],
    "donts": [
      "**Don't** replace flat settings sections with shadowed cards.",
      "**Don't** communicate current mode, validation or account status through color alone.",
      "**Don't** allow a desktop sidebar or two-column auth composition to force horizontal scrolling on mobile.",
      "**Don't** add photographic decoration to the existing account-form patterns."
    ]
  }
