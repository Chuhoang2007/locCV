{
  "name": "loccv",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:live": "tsx scripts/verify-supabase.ts",
    "db:types": "supabase gen types typescript --local > src/lib/db.types.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:types:local": "tsx scripts/generate-local-db-types.ts",
    "worker:build": "tsc -p tsconfig.worker.json",
    "worker": "node --conditions=react-server dist/worker/main.js",
    "worker:dev": "node --conditions=react-server --import tsx worker/main.ts",
    "ai:check": "node --conditions=react-server --import tsx scripts/check-ai.ts",
    "phase3:check": "node --conditions=react-server --import tsx scripts/check-phase3.ts",
    "phase4:check": "node --conditions=react-server --import tsx scripts/check-phase4.ts",
    "phase5:check": "node --conditions=react-server --import tsx scripts/check-phase5.ts",
    "security:client": "tsx scripts/check-client-secrets.ts",
    "test:containers": "node scripts/check-containers.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@hookform/resolvers": "7.0.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.66.0",
    "next": "16.4.4",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "saxes": "6.0.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.14",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "dotenv": "18.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
